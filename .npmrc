# Supply-chain guards for anyone installing this repo's dev tooling.

# No install scripts. Most npm compromises run there, and nothing this repo needs requires one:
# keccak/secp256k1 fall back to pure JS and esbuild ships its binary as a platform package.
# Run `npm rebuild <pkg>` by hand if you ever need a package's native build.
ignore-scripts=true

# Registry packages only: no dependencies fetched from git repos or arbitrary URLs.
allow-git=none
allow-remote=none

# Never install a version published less than 7 days ago; most malicious releases are caught and
# pulled within that window. Needs npm >= 11.10 — older npm ignores this line silently, which is
# why package.json requires that npm version and engine-strict turns the mismatch into an error.
min-release-age=7
engine-strict=true
